---
import { App } from "../App.jsx";
import "../styles.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Open-source, self-hosted uptime monitoring for websites, APIs, service ports and DNS. Get alerts by email, Discord, Slack, Telegram, Teams, PagerDuty or webhook." />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href="https://arveld.com/" />
    <link rel="icon" type="image/svg+xml" href="/arveld-mark.svg" />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <title>Arveld · Open-source uptime monitoring</title>
  </head>
  <body><App client:load /></body>
</html>
